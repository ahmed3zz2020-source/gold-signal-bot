# ── copy this file to .env and fill in YOUR values (never commit the filled-in one) ──
# ── on Windows: set the variables in the terminal, or load .env before running ──

# where the signal engine lives (the VPS polls THIS, never the other way round)
ENGINE_URL=https://your-bridge.up.railway.app
BRIDGE_TOKEN=put-a-long-random-string-here

# your Exness MT5 account (the server name must be copied EXACTLY, number included)
MT5_LOGIN=458089169
MT5_PASSWORD=your-password-here
MT5_SERVER=Exness-MT5Real50
# leave MT5_SYMBOL empty and the bridge auto-detects XAUUSD / XAUUSDm / XAUUSDc
MT5_SYMBOL=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ══ الحجم: لوت ثابت 0.01 (طلب صاحب الحساب) ══
# FIXED_VOLUME > 0 => نفس الحجم في كل صفقة. خلّيه 0 لو عايز الحساب بالنسبة من الرصيد.
FIXED_VOLUME=0.01
# عدد الصفقات المسموح في اليوم
MAX_TRADES_PER_DAY=10

# ══ حراسة الحساب الصغير (Standard Cent — الرصيد بالـ cents) ══
# ⚠ الأرقام دي مع الرصيد الحالي 3,353 USC (= $33.53) ولوت 0.01 (= 1 أونصة):
#   وقف $2 = 200 USC = 6% من الرصيد · وقف $4 = 400 USC = 12% · وقف $6 = 600 USC = 18%
#   ⇒ لما الحساب يكبر، نزّل الأرقام دي proportionally (يعني 2% و 6%).
# أقصى مخاطرة لصفقة واحدة (نسبة من الرصيد) — بيحسبها من الحجم والوقف الحقيقي + السبريد
MAX_RISK_PCT_PER_TRADE=20
# سقف خسارة اليوم (نسبة من الرصيد) — والحد بالـ R هو الأقوى
DAILY_CAP_PCT=45
# سقف اليوم بالـ R: بعد 3 صفقات خاسرة يقف نهار اليوم
DAILY_CAP_R=3
# شريط الوقف: أقل من كده ضوضاء، أكتر من كده الحساب الصغير بيتدمّر
MIN_STOP_POINTS=2
MAX_STOP_POINTS=10
# أقصى سبريد مقبول (نقطة) — السبريد بيتاكل من ربحك
MAX_SPREAD_POINTS=1.0
# أقصى هامش مستخدم من الحساب (نسبة) — مع رافعة 1:2000 دي أهم حماية
MAX_MARGIN_USE_PCT=30
# أقصى انحراف السعر عن نقطة الدخول (نقطة)
MAX_PRICE_DRIFT=2.0
# أقصى عمر للإشارة (ثانية)
MAX_SIGNAL_AGE_S=120
# وضع تنفيذ الأمر عند البروكر (IOC / FOK / RETURN) — لو رفض، الجسر يجرّب التاني
ORDER_FILLING=IOC

# 1 = log what it WOULD do and show it on the chart, without sending any order
DRY_RUN=1
POLL_SECONDS=5
BRIDGE_LOG=bridge.jsonl
